# ============================================================
# AI R&D Agent - Environment Configuration
# ============================================================

# LLM Settings (DeepSeek / OpenAI compatible)
LLM_API_KEY=your key
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro#自行选择
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Embedding Settings
# Options: "onnx" | "local" | "openai" | "offline"
#   onnx    -> 本地 BGE-M3 走 onnxruntime，不需要 PyTorch（推荐）
#   local   -> 本地 BGE-M3 走 sentence-transformers（需装 torch）
#   openai  -> 调用 OpenAI 兼容 /embeddings 接口
#   offline -> 哈希向量兜底，语义检索不可用
EMBEDDING_MODE=onnx
# EMBEDDING_MODEL 可以是 HF 仓库名，也可以是本地模型目录
EMBEDDING_MODEL=D:/1求职/1/fault-diagnosis-agent/bge-m3#从huggingface上自己下载写入自己文件的位置（这里是我自己的）
EMBEDDING_MAX_LENGTH=1024
# If EMBEDDING_MODE=openai, uses text-embedding-3-small via LLM_API_KEY

# Reranker Settings
# 注意：onnxruntime 无法从含中文的路径加载大型自包含图（报 system error 13），
# 模型必须放在纯英文路径下。bge-m3 不受影响（权重在独立的 model.onnx_data 文件）。
USE_RERANKER=true
RERANKER_ONNX_PATH=D:/models/bge-reranker-base#从huggingface上自己下载写入自己文件的位置
RERANKER_MAX_LENGTH=512
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=rd_agent_docs

# Redis (optional - uses in-memory fallback if not available)
REDIS_URL=redis://localhost:6379
# Conversation history lifespan in seconds (7 days). Previously 3600 (1h),
# which silently erased conversations an hour after the last message.
REDIS_TTL=604800

# RAG Config
TOP_K_RETRIEVE=10
TOP_K_RERANK=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# App Settings
APP_NAME=AI R&D Agent
API_V1_STR=/api/v1
MAX_RETRY_ITERATIONS=2
DEBUG=false

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
